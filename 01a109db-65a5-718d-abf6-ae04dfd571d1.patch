+async function extractEntitiesForEmail(
+  userId: string,
+  savedEmail: { id: string; subject: string | null; sender: string | null; senderEmail: string | null },
+  classification: EmailClassification,
+  snippet: string
+): Promise<{
+  linkedJobAppId: string | null;
