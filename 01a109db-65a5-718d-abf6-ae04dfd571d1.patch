+}> = [
+  { company: "Stripe", role: "Senior Frontend Engineer", status: "UNAPPLIED", source: "LinkedIn", notes: "Payments platform. Strong TypeScript + React.", link: "https://stripe.com/jobs", daysAgo: 1 },
+  { company: "Vercel", role: "Full Stack Engineer", status: "UNAPPLIED", source: "Company Site", notes: "Next.js core-adjacent team.", link: "https://vercel.com/careers", daysAgo: 2 },
+  { company: "Linear", role: "Product Engineer", status: "WISHLIST", source: "Twitter/X", notes: "Issue tracker. Love the product.", link: "https://linear.app", contactName: "Karri Saarinen", daysAgo: 4 },
+  { company: "Notion", role: "Software Engineer, Editor", status: "WISHLIST", source: "LinkedIn", notes: "Editor performance work.", link: "https://www.notion.so/careers", daysAgo: 6 },
+  { company: "Figma", role: "Software Engineer", status: "APPLIED", source: "Company Site", notes: "Applied via careers page. Multiplayer canvas.", link: "https://www.figma.com/careers", contactName: "Recruiting Team", contactEmail: "careers@figma.com", daysAgo: 8 },
+  { company: "Airbnb", role: "Frontend Engineer", status: "APPLIED", source: "LinkedIn", notes: "Submitted tailored resume.", link: "https://careers.airbnb.com", daysAgo: 10 },
