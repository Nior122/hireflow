+export interface StoredDocument {
+  id: string;
+  kind: "resume" | "cover" | "other";
+  name: string;
+  mime: string;
+  size: number;
+  data: string;
+  uploadedAt: string;
+}
+
+export const MAX_DOCUMENT_BYTES = 1_500_000;
+
+export function parseStoredDocuments(raw: unknown): StoredDocument[] {
+  if (!Array.isArray(raw)) return [];
+  return raw.filter((d): d is StoredDocument =>
+    Boolean(d && typeof d === "object" && typeof (d as StoredDocument).id === "string" && typeof (d as StoredDocument).data === "string")
+  );
+}
