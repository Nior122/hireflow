+  { company: "Google", role: "Software Engineer, L4", status: "INTERVIEW", source: "LinkedIn", notes: "Phone screen done. Onsite scheduled.", link: "https://careers.google.com", contactName: "Priya Nair", contactEmail: "priya.nair@google.com", daysAgo: 18 },
+  { company: "Meta", role: "Product Engineer", status: "INTERVIEW", source: "Company Site", notes: "System design round next week.", link: "https://www.metacareers.com", contactName: "Jordan Lee", daysAgo: 20 },
+  { company: "Microsoft", role: "Software Engineer II", status: "INTERVIEW", source: "Referral", notes: "Azure frontend team.", link: "https://careers.microsoft.com", daysAgo: 22 },
+  { company: "OpenAI", role: "Frontend Engineer", status: "OFFER", source: "Email", notes: "Verbal offer. Comp discussion in progress.", link: "https://openai.com/careers", contactName: "Taylor Brooks", contactEmail: "taylor@openai.com", daysAgo: 28 },
+  { company: "Anthropic", role: "Full Stack Engineer", status: "OFFER", source: "Company Site", notes: "Written offer received.", link: "https://www.anthropic.com/careers", daysAgo: 30 },
