--- /dev/null
+++ b/src/components/ReminderNotifier.tsx
@@ -0,0 +1,43 @@
+'use client';
+
+import { useEffect, useRef } from "react";
+import { getReminders } from "@/actions/reminders";
+import { getAccountSettings } from "@/actions/account";
+
+export function ReminderNotifier() {
+  const started = useRef(false);
+
+  useEffect(() => {
+    if (started.current) return;
+    started.current = true;
+    if (typeof window === "undefined" || !("Notification" in window)) return;
+
+    async function run() {
+      const [prefs, reminders] = await Promise.all([getAccountSettings(), getReminders()]);
+      if (!prefs.success || !prefs.data.notificationPrefs.interviewReminders) return;
+      if (!reminders.success) return;
+      const pending = (reminders.data ?? []).filter((r) => !r.isCompleted);
+      if (pending.length === 0) return;
+
+      if (Notification.permission === "default") {
+        await Notification.requestPermission();
+      }
+      if (Notification.permission !== "granted") return;
+
+      const now = Date.now();
+      for (const r of pending) {
+        const due = new Date(r.dueDate).getTime();
+        if (due <= now) {
+          new Notification("HireFlow reminder", { body: `${r.title} is overdue` });
+        } else if (due - now < 24 * 60 * 60 * 1000) {
+          window.setTimeout(() => {
+            new Notification("HireFlow reminder", { body: r.title });
+          }, Math.min(due - now, 2_147_000_000));
+        }
+      }
+    }
+    void run();
+  }, []);
+
+  return null;
+}
