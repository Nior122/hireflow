+  { company: "Cloudflare", role: "Systems Frontend Engineer", status: "WISHLIST", source: "AngelList", notes: "Workers + dashboard.", link: "https://www.cloudflare.com/careers", daysAgo: 3 },
+  { company: "GitHub", role: "Software Engineer, Copilot", status: "APPLIED", source: "Email", notes: "Recruiter reached out.", link: "https://github.com/about/careers", contactName: "Sam Rivera", contactEmail: "sam.r@github.com", daysAgo: 9 },
+];
+
+export async function loadSampleApplications(): Promise<ActionResponse<{ count: number }>> {
+  try {
+    const user = await createOrGetUser();
+    const existing = await prisma.jobApplication.count({
+      where: { userId: user.id, source: SAMPLE_SOURCE },
+    });
+    if (existing > 0) {
+      return { success: false, error: "Sample jobs are already loaded. Reset demo data first to load them again." };
+    }
+
+    const lastByStatus: Record<string, number> = {};
+    const created = await prisma.$transaction(
+      SAMPLE_JOBS.map((job) => {
+        const pos = lastByStatus[job.status] ?? 0;
+        lastByStatus[job.status] = pos + 1;
+        const createdAt = new Date(Date.now() - job.daysAgo * 24 * 60 * 60 * 1000);
+        return prisma.jobApplication.create({
+          data: {
+            userId: user.id,
+            company: job.company,
+            role: job.role,
+            status: job.status,
+            source: SAMPLE_SOURCE,
+            notes: `${job.notes}\nOriginal source: ${job.source}`,
+            link: job.link,
+            contactName: job.contactName ?? null,
+            contactEmail: job.contactEmail ?? null,
+            position: pos,
+            createdAt,
+            updatedAt: createdAt,
+          },
+        });
+      })
+    );
+
+    await logActivity(user.id, "APPLICATION_CREATED", `Loaded ${created.length} sample applications`);
+    revalidatePath("/dashboard");
+    return { success: true, data: { count: created.length } };
+  } catch (e) {
+    console.error("loadSampleApplications", e);
+    return { success: false, error: "Failed to load sample jobs" };
+  }
+}
+
+export async function resetSampleData(): Promise<ActionResponse<{ count: number }>> {
