+export async function uploadApplicationDocument(input: {
+  applicationId: string;
+  kind: StoredDocument["kind"];
+  name: string;
+  mime: string;
+  data: string;
+}): Promise<ActionResponse<StoredDocument[]>> {
+  try {
+    const user = await createOrGetUser();
+    const app = await prisma.jobApplication.findFirst({ where: { id: input.applicationId, userId: user.id } });
+    if (!app) return { success: false, error: "Application not found" };
+    const size = Math.ceil((input.data.length * 3) / 4);
+    if (size > MAX_DOCUMENT_BYTES) return { success: false, error: "File is too large (max 1.5 MB)" };
+    const allowed = ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/msword", "text/plain", "image/png", "image/jpeg"];
+    if (!allowed.includes(input.mime) && !input.name.match(/\.(pdf|docx?|txt|png|jpe?g)$/i)) {
+      return { success: false, error: "Allowed types: PDF, DOCX, DOC, TXT, PNG, JPG" };
+    }
+    const docs = parseStoredDocuments(app.otherDocuments);
+    const next: StoredDocument = {
+      id: crypto.randomUUID(),
+      kind: input.kind,
+      name: input.name.slice(0, 200),
+      mime: input.mime || "application/octet-stream",
+      size,
+      data: input.data,
+      uploadedAt: new Date().toISOString(),
+    };
+    const merged = [...docs.filter((d) => d.kind !== input.kind || input.kind === "other"), next];
