index 0000000..582dd30
--- /dev/null
+++ b/src/actions/account.ts
@@ -0,0 +1,89 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { prisma } from "@/lib/prisma";
+import { createOrGetUser } from "@/lib/clerk";
+import { getGroqApiKey } from "@/lib/ai/groq";
+import type { ActionResponse } from "@/lib/types";
+
+export interface AccountSettings {
+  email: string | null;
+  companyName: string | null;
+  role: "JOB_SEEKER" | "EMPLOYER";
+  groqConfigured: boolean;
+  groqModel: string | null;
+  gmailConnected: boolean;
+  calendarConnected: boolean;
+  notificationPrefs: {
+    emailSummaries: boolean;
+    interviewReminders: boolean;
+  };
+}
+
+const DEFAULT_PREFS = { emailSummaries: true, interviewReminders: true };
+
+export async function getAccountSettings(): Promise<ActionResponse<AccountSettings>> {
+  try {
+    const user = await createOrGetUser();
+    const [gmail, calendar] = await Promise.all([
+      prisma.gmailToken.findUnique({ where: { userId: user.id }, select: { id: true } }),
+      prisma.calendarConnection.findUnique({ where: { userId: user.id }, select: { id: true } }),
+    ]);
+    const prefsRaw = user.notificationPrefs;
+    const prefs =
+      prefsRaw && typeof prefsRaw === "object" && !Array.isArray(prefsRaw)
+        ? { ...DEFAULT_PREFS, ...(prefsRaw as Record<string, unknown>) }
+        : DEFAULT_PREFS;
+
+    return {
+      success: true,
+      data: {
+        email: user.email,
+        companyName: user.companyName,
+        role: user.role === "EMPLOYER" ? "EMPLOYER" : "JOB_SEEKER",
+        groqConfigured: Boolean(getGroqApiKey()),
+        groqModel: process.env.GROQ_MODEL?.trim() || null,
+        gmailConnected: Boolean(gmail),
+        calendarConnected: Boolean(calendar),
+        notificationPrefs: {
+          emailSummaries: Boolean(prefs.emailSummaries),
+          interviewReminders: Boolean(prefs.interviewReminders),
+        },
+      },
+    };
+  } catch {
+    return { success: false, error: "Failed to load account settings" };
+  }
+}
+
+export async function updateAccountSettings(input: {
+  companyName?: string;
+  role?: "JOB_SEEKER" | "EMPLOYER";
+  notificationPrefs?: { emailSummaries?: boolean; interviewReminders?: boolean };
+}): Promise<ActionResponse<AccountSettings>> {
+  try {
+    const user = await createOrGetUser();
+    const currentPrefs =
+      user.notificationPrefs && typeof user.notificationPrefs === "object" && !Array.isArray(user.notificationPrefs)
+        ? (user.notificationPrefs as Record<string, unknown>)
+        : DEFAULT_PREFS;
+
+    const updated = await prisma.user.update({
+      where: { id: user.id },
+      data: {
+        ...(input.companyName !== undefined ? { companyName: input.companyName.trim() || null } : {}),
+        ...(input.role ? { role: input.role } : {}),
+        ...(input.notificationPrefs
+          ? { notificationPrefs: { ...currentPrefs, ...input.notificationPrefs } }
+          : {}),
+      },
+    });
+    void updated;
+    revalidatePath("/dashboard");
