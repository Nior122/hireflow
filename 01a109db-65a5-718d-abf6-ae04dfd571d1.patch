+    });
+    await logActivity(user.id, "APPLICATION_DELETED", `Reset ${result.count} sample applications`);
+    revalidatePath("/dashboard");
+    return { success: true, data: { count: result.count } };
+  } catch {
+    return { success: false, error: "Failed to reset sample data" };
+  }
+}
+
+export async function getSampleDataStatus(): Promise<ActionResponse<{ loaded: boolean; count: number }>> {
+  try {
+    const user = await createOrGetUser();
+    const count = await prisma.jobApplication.count({
+      where: { userId: user.id, source: SAMPLE_SOURCE },
+    });
+    return { success: true, data: { loaded: count > 0, count } };
+  } catch {
+    return { success: false, error: "Failed" };
+  }
+}
+
+export type { ApplicationCard };
