new file mode 100644
index 0000000..7faeee8
--- /dev/null
+++ b/src/actions/create-cv.ts
@@ -0,0 +1,141 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { z } from "zod";
+import { prisma, Prisma } from "@/lib/prisma";
+import { createOrGetUser } from "@/lib/clerk";
+import { groqChatJson, getGroqApiKey } from "@/lib/ai/groq";
+import { analyzeAts, resumeToText } from "@/lib/resume/ats";
+import type { ActionResponse } from "@/lib/types";
+
+const ExperienceSchema = z.object({
+  company: z.string(),
+  role: z.string(),
+  period: z.string().optional(),
+  bullets: z.array(z.string()).optional(),
+});
+const EducationSchema = z.object({
+  school: z.string(),
+  degree: z.string().optional(),
+  year: z.string().optional(),
+});
+const CvJsonSchema = z.object({
+  title: z.string(),
+  summary: z.string(),
+  experience: z.array(ExperienceSchema).default([]),
+  education: z.array(EducationSchema).default([]),
+  skills: z.array(z.string()).default([]),
+});
+
+export interface CreateCvInput {
+  fullName: string;
+  email: string;
+  phone?: string;
+  location?: string;
+  targetRole: string;
+  yearsExperience?: string;
+  skills: string;
+  experience: string;
+  education: string;
+  extras?: string;
+}
+
+export async function createFullCvFromDetails(input: CreateCvInput): Promise<ActionResponse<{ resumeId: string; atsScore: number }>> {
+  try {
+    const user = await createOrGetUser();
+    const details = [
+      `Name: ${input.fullName}`,
+      `Email: ${input.email}`,
+      input.phone ? `Phone: ${input.phone}` : "",
+      input.location ? `Location: ${input.location}` : "",
+      `Target role: ${input.targetRole}`,
+      input.yearsExperience ? `Years of experience: ${input.yearsExperience}` : "",
+      `Skills: ${input.skills}`,
+      `Work experience:\n${input.experience}`,
+      `Education:\n${input.education}`,
+      input.extras ? `More context:\n${input.extras}` : "",
+    ].filter(Boolean).join("\n");
+
+    let parsed: z.infer<typeof CvJsonSchema>;
+    if (getGroqApiKey() || process.env.DEMO_MODE === "true") {
+      const groq = await groqChatJson({
+        messages: [
+          {
+            role: "system",
+            content: `You are an expert ATS resume writer. Return ONLY valid JSON (no HTML): { "title": string, "summary": string, "experience": [{ "company": string, "role": string, "period": string, "bullets": string[] }], "education": [{ "school": string, "degree": string, "year": string }], "skills": string[] }`,
+          },
+          { role: "user", content: details },
+        ],
+        temperature: 0.4,
+        max_tokens: 1800,
+      });
+      if (!groq.ok) return { success: false, error: groq.error ?? "AI failed to generate the CV" };
+      const raw = groq.content.replace(/```json\n?/g, "").replace(/```/g, "").trim();
+      const jsonStart = raw.indexOf("{");
+      const jsonEnd = raw.lastIndexOf("}");
+      parsed = CvJsonSchema.parse(JSON.parse(raw.slice(jsonStart, jsonEnd + 1)));
+    } else {
+      parsed = {
+        title: input.targetRole,
+        summary: `${input.fullName} is a ${input.targetRole} based in ${input.location || "their market"} with skills in ${input.skills}.`,
+        experience: input.experience.split("\n").filter(Boolean).slice(0, 3).map((line) => ({
+          company: "Previous company",
+          role: input.targetRole,
+          period: "",
+          bullets: [line],
+        })),
+        education: [{ school: input.education.split("\n")[0] || "University", degree: "", year: "" }],
+        skills: input.skills.split(",").map((s) => s.trim()).filter(Boolean),
+      };
+    }
+
+    const contactLine = [input.fullName, input.email, input.phone, input.location].filter(Boolean).join(" · ");
+    const sections = [
+      {
+        type: "EXPERIENCE" as const,
+        title: "Work Experience",
+        order: 0,
+        content: { items: parsed.experience.map((e) => ({ company: e.company, role: e.role, period: e.period ?? "", bullets: e.bullets ?? [] })) },
+      },
+      {
+        type: "EDUCATION" as const,
+        title: "Education",
+        order: 1,
+        content: { items: parsed.education.map((e) => ({ school: e.school, degree: e.degree ?? "", year: e.year ?? "" })) },
+      },
+      {
+        type: "SKILLS" as const,
+        title: "Skills",
+        order: 2,
+        content: { items: [{ skills: parsed.skills }] },
+      },
+    ];
+
+    const summary = `${contactLine}\n\n${parsed.summary}`;
+    const ats = analyzeAts(resumeToText({ title: parsed.title, summary, sections }), sections);
+
+    const resume = await prisma.resume.create({
+      data: {
+        userId: user.id,
+        name: `${input.fullName} — ${parsed.title}`,
+        title: parsed.title,
+        summary,
+        atsScore: ats.overallScore,
+        sections: {
+          create: sections.map((s) => ({
+            type: s.type,
+            title: s.title,
+            order: s.order,
+            content: s.content as Prisma.InputJsonValue,
+          })),
+        },
+      },
+    });
+
+    revalidatePath("/dashboard/resume");
+    return { success: true, data: { resumeId: resume.id, atsScore: ats.overallScore } };
+  } catch (e) {
+    console.error("createFullCvFromDetails", e);
+    return { success: false, error: "Failed to create CV" };
+  }
+}
