diff --git a/src/actions/review-inbox.ts b/src/actions/review-inbox.ts
new file mode 100644
index 0000000..df11254
--- /dev/null
+++ b/src/actions/review-inbox.ts
@@ -0,0 +1,100 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { prisma } from "@/lib/prisma";
+import { createOrGetUser } from "@/lib/clerk";
+import type { ActionResponse } from "@/lib/types";
+
+export interface ReviewDraft {
+  id: string;
+  body: string;
+  status: string;
+  createdAt: Date;
+  sentAt: Date | null;
+  candidate: { id: string; name: string; email: string; positionApplied: string };
+}
+
+export async function getReviewInbox(): Promise<ActionResponse<ReviewDraft[]>> {
+  try {
+    const user = await createOrGetUser();
+    const drafts = await prisma.aiReply.findMany({
+      where: { candidate: { employerId: user.id }, status: { in: ["DRAFT", "SENT"] } },
+      orderBy: { createdAt: "desc" },
+      take: 50,
+      include: { candidate: { select: { id: true, name: true, email: true, positionApplied: true } } },
+    });
+    return { success: true, data: drafts };
+  } catch {
+    return { success: false, error: "Failed to load review inbox" };
+  }
+}
+
+export async function updateReviewDraft(id: string, body: string): Promise<ActionResponse<void>> {
+  try {
+    const user = await createOrGetUser();
+    const draft = await prisma.aiReply.findFirst({ where: { id, candidate: { employerId: user.id } } });
+    if (!draft) return { success: false, error: "Draft not found" };
+    await prisma.aiReply.update({ where: { id }, data: { body } });
+    return { success: true, data: undefined };
+  } catch {
+    return { success: false, error: "Failed to save draft" };
+  }
+}
+
+export async function decideReviewDraft(
+  id: string,
+  decision: "SEND" | "SKIP" | "REJECT"
+): Promise<ActionResponse<{ sent?: boolean }>> {
+  try {
+    const user = await createOrGetUser();
+    const draft = await prisma.aiReply.findFirst({
+      where: { id, candidate: { employerId: user.id } },
+      include: { candidate: true },
+    });
+    if (!draft) return { success: false, error: "Draft not found" };
+
+    if (decision === "SKIP" || decision === "REJECT") {
+      await prisma.aiReply.update({ where: { id }, data: { status: "REJECTED" } });
+      await prisma.candidateActivity.create({
+        data: { candidateId: draft.candidateId, action: decision === "SKIP" ? "REPLY_SKIPPED" : "REPLY_REJECTED", detail: "Review inbox" },
+      });
+      revalidatePath("/dashboard");
+      return { success: true, data: { sent: false } };
+    }
+
+    // SEND — never auto-sends; this is an explicit employer action.
+    let sent = false;
+    const token = await prisma.gmailToken.findUnique({ where: { userId: user.id } });
+    if (token) {
+      try {
+        const { google } = await import("googleapis");
+        const oauth2Client = new google.auth.OAuth2(
+          process.env.GOOGLE_CLIENT_ID,
+          process.env.GOOGLE_CLIENT_SECRET,
+        );
+        oauth2Client.setCredentials({ access_token: token.accessToken, refresh_token: token.refreshToken });
+        const gmail = google.gmail({ version: "v1", auth: oauth2Client });
+        const raw = Buffer.from(
+          `To: ${draft.candidate.email}\r\nSubject: ${draft.candidate.positionApplied}\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n${draft.body}`
+        ).toString("base64url");
+        await gmail.users.messages.send({ userId: "me", requestBody: { raw } });
+        sent = true;
+      } catch (e) {
+        console.error("Gmail send failed", e);
+      }
+    }
+
+    await prisma.aiReply.update({ where: { id }, data: { status: "SENT", sentAt: new Date() } });
+    await prisma.candidateActivity.create({
+      data: {
+        candidateId: draft.candidateId,
+        action: "REPLY_SENT",
+        detail: sent ? "Sent via Gmail" : "Marked sent (copy to send manually — Gmail not connected or send failed)",
+      },
+    });
+    revalidatePath("/dashboard");
+    return { success: true, data: { sent } };
+  } catch {
+    return { success: false, error: "Failed to update draft" };
+  }
+}
