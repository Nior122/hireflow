new file mode 100644
index 0000000..df8e643
--- /dev/null
+++ b/src/components/CreateCvWizard.tsx
@@ -0,0 +1,82 @@
+'use client';
+
+import { useState, useTransition } from "react";
+import { toast } from "sonner";
+import { Sparkles, Loader2 } from "lucide-react";
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+import { Label } from "@/components/ui/label";
+import { createFullCvFromDetails } from "@/actions/create-cv";
+
+interface Props {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onCreated: () => void;
+}
+
+export function CreateCvWizard({ open, onOpenChange, onCreated }: Props) {
+  const [pending, start] = useTransition();
+
+  function handleSubmit(formData: FormData) {
+    const fullName = String(formData.get("fullName") ?? "").trim();
+    const email = String(formData.get("email") ?? "").trim();
+    const targetRole = String(formData.get("targetRole") ?? "").trim();
+    const skills = String(formData.get("skills") ?? "").trim();
+    const experience = String(formData.get("experience") ?? "").trim();
+    const education = String(formData.get("education") ?? "").trim();
+    if (!fullName || !email || !targetRole || !skills || !experience) {
+      toast.error("Name, email, target role, skills, and experience are required");
+      return;
+    }
+    start(async () => {
+      const result = await createFullCvFromDetails({
+        fullName,
+        email,
+        phone: String(formData.get("phone") ?? "").trim() || undefined,
+        location: String(formData.get("location") ?? "").trim() || undefined,
+        targetRole,
+        yearsExperience: String(formData.get("yearsExperience") ?? "").trim() || undefined,
+        skills,
+        experience,
+        education,
+        extras: String(formData.get("extras") ?? "").trim() || undefined,
+      });
+      if (result.success) {
+        toast.success(`CV created. ATS score ${result.data.atsScore}/100`);
+        onOpenChange(false);
+        onCreated();
+      } else toast.error(result.error ?? "Failed to create CV");
+    });
+  }
+
+  return (
+    <Dialog open={open} onOpenChange={onOpenChange}>
+      <DialogContent className="sm:max-w-lg max-h-[90vh] overflow-y-auto">
+        <DialogHeader>
+          <DialogTitle className="flex items-center gap-2"><Sparkles className="h-4 w-4 text-amber-500" /> Create a full CV from your details</DialogTitle>
+        </DialogHeader>
+        <form action={handleSubmit} className="space-y-3">
+          <p className="text-xs text-muted-foreground">Enter your background. HireFlow writes a standard ATS-friendly CV, then scores it.</p>
+          <div className="grid grid-cols-2 gap-3">
+            <div className="space-y-1"><Label className="text-xs">Full name *</Label><Input name="fullName" required className="h-8" /></div>
+            <div className="space-y-1"><Label className="text-xs">Email *</Label><Input name="email" type="email" required className="h-8" /></div>
+            <div className="space-y-1"><Label className="text-xs">Phone</Label><Input name="phone" className="h-8" /></div>
+            <div className="space-y-1"><Label className="text-xs">Location</Label><Input name="location" className="h-8" placeholder="Berlin, DE" /></div>
+            <div className="space-y-1"><Label className="text-xs">Target role *</Label><Input name="targetRole" required className="h-8" placeholder="Frontend Engineer" /></div>
+            <div className="space-y-1"><Label className="text-xs">Years of experience</Label><Input name="yearsExperience" className="h-8" placeholder="5" /></div>
+          </div>
+          <div className="space-y-1"><Label className="text-xs">Skills * (comma separated)</Label><Input name="skills" required placeholder="TypeScript, React, Node.js" className="h-8" /></div>
+          <div className="space-y-1"><Label className="text-xs">Work experience *</Label><Textarea name="experience" required rows={4} placeholder="Company — Role — years&#10;Led a team of 4, shipped X, improved Y by 30%." className="text-sm" /></div>
+          <div className="space-y-1"><Label className="text-xs">Education</Label><Textarea name="education" rows={2} placeholder="University, degree, year" className="text-sm" /></div>
+          <div className="space-y-1"><Label className="text-xs">Anything else</Label><Textarea name="extras" rows={2} placeholder="Languages, certifications, projects" className="text-sm" /></div>
+          <Button type="submit" className="w-full gap-2" disabled={pending}>
+            {pending ? <Loader2 className="h-4 w-4 animate-spin" /> : <Sparkles className="h-4 w-4" />}
+            {pending ? "Writing your CV..." : "Generate CV + ATS score"}
+          </Button>
+        </form>
+      </DialogContent>
+    </Dialog>
+  );
+}
