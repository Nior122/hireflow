diff --git a/src/components/ReviewInbox.tsx b/src/components/ReviewInbox.tsx
new file mode 100644
index 0000000..cdfee2d
--- /dev/null
+++ b/src/components/ReviewInbox.tsx
@@ -0,0 +1,77 @@
+'use client';
+
+import { useEffect, useState, useTransition } from "react";
+import { toast } from "sonner";
+import { Inbox, Loader2, Send, X, SkipForward } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Textarea } from "@/components/ui/textarea";
+import { Badge } from "@/components/ui/badge";
+import { getReviewInbox, updateReviewDraft, decideReviewDraft, type ReviewDraft } from "@/actions/review-inbox";
+
+export function ReviewInbox() {
+  const [drafts, setDrafts] = useState<ReviewDraft[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [pending, start] = useTransition();
+  const [editing, setEditing] = useState<Record<string, string>>({});
+
+  function load() {
+    getReviewInbox().then((r) => {
+      if (r.success) setDrafts(r.data.filter((d) => d.status === "DRAFT"));
+      setLoading(false);
+    });
+  }
+
+  useEffect(() => { load(); }, []);
+
+  function bodyOf(d: ReviewDraft) {
+    return editing[d.id] ?? d.body;
+  }
+
+  function decide(id: string, decision: "SEND" | "SKIP" | "REJECT") {
+    start(async () => {
+      if (editing[id]) await updateReviewDraft(id, editing[id]);
+      const res = await decideReviewDraft(id, decision);
+      if (!res.success) { toast.error(res.error); return; }
+      if (decision === "SEND") {
+        toast.success(res.data.sent ? "Reply sent via Gmail" : "Marked sent. Copy the text if Gmail is not connected.");
+      } else toast.success(decision === "SKIP" ? "Skipped" : "Rejected");
+      load();
+    });
+  }
+
+  if (loading) return <div className="py-8 text-center text-sm text-muted-foreground">Loading review inbox…</div>;
+
+  if (drafts.length === 0) {
+    return (
+      <div className="text-center py-12 border-2 border-dashed rounded-xl">
+        <Inbox className="h-8 w-8 mx-auto mb-2 text-muted-foreground/40" />
+        <p className="font-medium">No drafts waiting</p>
+        <p className="text-sm text-muted-foreground mt-1">Generate an AI reply on a candidate card and it will appear here for review. Nothing is sent automatically.</p>
+      </div>
+    );
+  }
+
+  return (
+    <div className="space-y-4">
+      <p className="text-sm text-muted-foreground">Approve, edit, send, skip, or reject. Auto-send is never used from this inbox.</p>
+      {drafts.map((d) => (
+        <div key={d.id} className="rounded-xl border p-4 space-y-3 bg-card">
+          <div className="flex items-center justify-between gap-2">
+            <div>
+              <p className="font-semibold text-sm">{d.candidate.name}</p>
+              <p className="text-xs text-muted-foreground">{d.candidate.positionApplied} · {d.candidate.email}</p>
+            </div>
+            <Badge variant="secondary">Draft</Badge>
+          </div>
+          <Textarea value={bodyOf(d)} onChange={(e) => setEditing((prev) => ({ ...prev, [d.id]: e.target.value }))} rows={6} className="text-sm" />
+          <div className="flex flex-wrap gap-2">
+            <Button size="sm" className="gap-1" disabled={pending} onClick={() => decide(d.id, "SEND")}><Send className="h-3 w-3" /> Send</Button>
+            <Button size="sm" variant="outline" className="gap-1" disabled={pending} onClick={() => decide(d.id, "SKIP")}><SkipForward className="h-3 w-3" /> Skip</Button>
+            <Button size="sm" variant="ghost" className="gap-1 text-destructive" disabled={pending} onClick={() => decide(d.id, "REJECT")}><X className="h-3 w-3" /> Reject</Button>
+            {pending && <Loader2 className="h-4 w-4 animate-spin text-muted-foreground" />}
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
