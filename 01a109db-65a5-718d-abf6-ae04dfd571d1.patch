+export interface GmailSyncSummary {
+  emailsProcessed: number;
+  emailsSkipped: number;
+  jobsDiscovered: number;
+  applicationsDiscovered: number;
+  interviewsDiscovered: number;
+  rejectionsDiscovered: number;
