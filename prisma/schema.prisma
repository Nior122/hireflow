generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JOB_SEEKER
  EMPLOYER
}

model User {
  id               String              @id @default(cuid())
  clerkId          String              @unique
  role             Role                @default(JOB_SEEKER)
  email            String?
  companyName      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  applications     JobApplication[]
  candidates       Candidate[]
  emailTemplates   EmailTemplate[]
  gmailToken       GmailToken?
  calendarConnection CalendarConnection?
  activities       ActivityLog[]
  reminders        Reminder[]
  savedJobs        SavedJob[]
  conversations    Conversation[]
  resumes          Resume[]
  coverLetters     CoverLetter[]
  interviews       Interview[]
  interviewQuestions InterviewQuestion[]
  orgMemberships   OrganizationMember[]
  orgInvitationsSent OrganizationInvitation[]
  auditLogs        AuditLog[]
  teamComments     TeamComment[]
  scorecards       CandidateScorecard[]
  assignedCandidates Candidate[]    @relation("AssignedToRecruiter")
  hiringManagerCandidates Candidate[] @relation("HiringManager")
  managedJobPostings JobPosting[]
  interviewersOnJobs JobPosting[]  @relation("InterviewerOnJobs")
  subscription      Subscription?
  apiKeys           ApiKey[]
  usageRecords      UsageRecord[]
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  stripeSubId     String?
  plan            PlanType  @default(FREE)
  status          SubStatus @default(ACTIVE)
  seats           Int       @default(1)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt     DateTime?
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PlanType { FREE PRO PREMIUM TEAM BUSINESS ENTERPRISE }
enum SubStatus { ACTIVE PAST_DUE CANCELED EXPIRED TRIALING }

model ApiKey {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  key         String     @unique
  scopes      String     @default("read")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?
}

model Webhook {
  id             String   @id @default(cuid())
  organizationId String?
  url            String
  secret         String
  events         String[]
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model WebhookEvent {
  id             String   @id @default(cuid())
  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String   @default("pending")
  responseCode   Int?
  attempts       Int      @default(0)
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  count     Int      @default(1)
  date      DateTime @default(now())
  metadata  Json?

  @@index([userId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  rules     Json?
  createdAt DateTime @default(now())
}

model OrganizationSetting {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandColor      String?
  logoUrl         String?
  emailBranding   Json?
  securityPolicy  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrgMemberRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
  VIEWER
}

enum OrgMemberStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  industry    String?
  companySize String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  jobPostings JobPosting[]
  auditLogs   AuditLog[]
}

model OrganizationMember {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            OrgMemberRole @default(VIEWER)
  status          OrgMemberStatus @default(ACTIVE)
  invitedById     String?
  joinedAt        DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvitation {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  role            OrgMemberRole @default(VIEWER)
  token           String   @unique
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime @default(now())
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model JobPosting {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  department      String?
  employmentType  String?
  location        String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  description     String?
  requirements    String?
  benefits        String?
  status          JobPostingStatus @default(DRAFT)
  hiringManagerId String?
  hiringManager   User?    @relation("HiringManager", fields: [hiringManagerId], references: [id])
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  candidates      Candidate[]
}

model TeamComment {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String
  isResolved      Boolean  @default(false)
  parentId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CandidateScorecard {
  id              String   @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  technicalScore  Int?
  communicationScore Int?
  problemSolvingScore Int?
  leadershipScore Int?
  cultureFitScore Int?
  overallScore    Int?
  recommendation  String?
  notes           String?
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action          String
  entity          String
  entityId        String?
  oldValue        Json?
  newValue        Json?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
}

enum ResumeSectionType {
  SUMMARY
  EXPERIENCE
  EDUCATION
  SKILLS
  PROJECTS
  CERTIFICATIONS
  LANGUAGES
  AWARDS
  CUSTOM
}

model Resume {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  title      String           @default("")
  summary    String           @default("")
  isDefault  Boolean          @default(false)
  atsScore   Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  sections   ResumeSection[]
  versions   ResumeVersion[]
  coverLetters CoverLetter[]

  @@index([userId])
}

model ResumeSection {
  id         String            @id @default(cuid())
  resumeId   String
  resume     Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  type       ResumeSectionType
  title      String
  order      Int               @default(0)
  content    Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model ResumeVersion {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber  Int
  notes          String?
  snapshot       Json
  createdAt      DateTime @default(now())
}

model CoverLetter {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String?
  resume     Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  company    String
  position   String
  content    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  roleContext  String
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     ConversationMessage[]

  @@index([userId])
}

model ConversationMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String
  content         String
  metadata        Json?
  createdAt       DateTime @default(now())
}

model GmailToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Status {
  UNAPPLIED
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model JobApplication {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             String
  role                String
  link                String?
  notes               String?
  status              Status   @default(UNAPPLIED)
  source              String?
  sourceEmailId       String?
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  contactLinkedin     String?
  resumeFileName      String?
  coverLetterFileName String?
  otherDocuments      Json?
  reminders           Reminder[]
  activities          ActivityLog[]

  @@index([userId])
}

model Reminder {
  id            String   @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  dueDate       DateTime
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([applicationId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  detail        String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Candidate {
  id                String   @id @default(cuid())
  employerId        String
  employer          User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  name              String
  email             String
  phone             String?
  positionApplied   String
  status            CandidateStatus @default(NEW)
  resumeText        String?
  coverLetter       String?
  keySkills         String[]
  experienceSummary String?
  sourceEmailId     String?
  emailBody         String?
  rating            Int?
  tags              String[]
  notes             String?
  position          Int      @default(0)
  appliedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  activities        CandidateActivity[]
  replies           AiReply[]
  jobPostingId      String?
  jobPosting        JobPosting? @relation(fields: [jobPostingId], references: [id])
  recruiterId       String?
  recruiter         User?    @relation("AssignedToRecruiter", fields: [recruiterId], references: [id])
  teamComments      TeamComment[]
  scorecards        CandidateScorecard[]

  @@index([employerId])
}

enum CandidateStatus {
  NEW
  REVIEWED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model EmailTemplate {
  id         String   @id @default(cuid())
  employerId String
  employer   User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String
  isDefault  Boolean  @default(false)
  autoSend   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AiReply {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  body        String
  sentAt      DateTime?
  status      ReplyStatus @default(DRAFT)
  createdAt   DateTime @default(now())
}

enum ReplyStatus {
  DRAFT
  SENT
  REJECTED
}

model CandidateActivity {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  action      String
  detail      String?
  createdAt   DateTime @default(now())
}

model CalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedJob {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId       String
  source           String
  title            String
  company          String
  location         String?
  remoteType       String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?
  description      String?
  requirements     String?
  skills           Json?
  companyLogo      String?
  companyWebsite   String?
  applicationUrl   String?
  postedAt         DateTime?
  importedToKanban Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, externalId, source])
  @@index([userId])
  @@index([source])
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  HR
  BEHAVIORAL
  SYSTEM_DESIGN
  PAIR_PROGRAMMING
  MANAGER_ROUND
  EXECUTIVE
  FINAL_ROUND
  ASSESSMENT
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
  MISSED
}

model Interview {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId     String?
  company           String
  position          String
  interviewType     InterviewType     @default(TECHNICAL)
  interviewRound    Int               @default(1)
  scheduledAt       DateTime?
  duration          Int?
  location          String?
  meetingLink       String?
  interviewerName   String?
  interviewerEmail  String?
  timezone          String?
  status            InterviewStatus   @default(SCHEDULED)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  practices         InterviewPractice[]
  questions         InterviewNote[]

  @@index([userId])
}

model InterviewPractice {
  id            String   @id @default(cuid())
  interviewId   String?
  interview     Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String?
  role          String?
  category      String
  difficulty    String
  question      String
  userAnswer    String?
  aiFeedback    Json?
  score         Int?
  createdAt     DateTime @default(now())
}

model InterviewQuestion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      String?
  role         String?
  category     String
  difficulty   String
  question     String
  answerGuide  String?
  tags         String[]
  createdAt    DateTime @default(now())
}

model InterviewNote {
  id            String   @id @default(cuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  type          String
  title         String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
